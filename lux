#!/usr/bin/env bash
# lux — órdenes de LuxCore. Sin dependencias más allá de Maven y un JDK 21.
#
# Las órdenes van en inglés, que es lo que espera quien llega de fuera. Las de antes
# —correr, probar, instalar…— siguen valiendo como alias y no se anuncian.
#
#   ./lux new <nombre>  crea un proyecto nuevo, listo para arrancar
#   ./lux run           arranca la aplicación de ejemplo
#   ./lux test          corre las pruebas
#   ./lux package       genera los JAR
#   ./lux fatjar        empaqueta un módulo en un jar ejecutable
#   ./lux install       compila e instala en el repositorio local
#   ./lux dist          arma el .tar.gz y el .zip que baja el instalador
#   ./lux clean         borra lo generado
#   ./lux cache         muestra qué ocupa la caché, y con --purge la vacía
#   ./lux docs          sirve la documentación estática con el propio LuxCore
#   ./lux portal        arranca lux-web: el sitio con acceso, demos y generador
#   ./lux build         regenera las páginas del sitio
#   ./lux status        resumen del proyecto
set -euo pipefail

AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAVA_DIR="$AQUI/java"
MVN=(mvn -B -q)

azul()  { printf '\033[38;5;205m%s\033[0m\n' "$*"; }
gris()  { printf '\033[38;5;245m%s\033[0m\n' "$*"; }
malo()  { printf '\033[38;5;167m%s\033[0m\n' "$*" >&2; }

requisitos() {
  command -v mvn >/dev/null || { malo "falta Maven"; exit 1; }
  command -v java >/dev/null || { malo "falta un JDK"; exit 1; }
  local v
  v=$(java -version 2>&1 | head -1 | sed -E 's/.*"([0-9]+).*/\1/')
  if [ "${v:-0}" -lt 21 ] 2>/dev/null; then
    malo "LuxCore necesita Java 21 o superior (hilos virtuales); tienes $v"
    exit 1
  fi
}

modulos() { echo "lux-http lux-core lux-view lux-data lux-adapter-servlet"; }
aplicaciones() { echo "ejemplo lux-web"; }

classpath_ejemplo() {
  local destino="$JAVA_DIR/ejemplo/target/classpath.txt"
  if [ ! -f "$destino" ] || [ "$JAVA_DIR/ejemplo/pom.xml" -nt "$destino" ]; then
    (cd "$JAVA_DIR/ejemplo" && "${MVN[@]}" dependency:build-classpath \
        -Dmdep.outputFile=target/classpath.txt >/dev/null)
  fi
  echo "$JAVA_DIR/ejemplo/target/classes:$(cat "$destino")"
}

version() { grep -m1 '<version>' "$JAVA_DIR/pom.xml" | sed 's/.*<version>\(.*\)<.*/\1/'; }

case "${1:-ayuda}" in

  new|nuevo)
    requisitos
    [ -n "${2:-}" ] || { malo "dime el nombre:  lux new mi-app [grupo] [motor]"; exit 1; }
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    cp="$JAVA_DIR/lux-web/target/classes:$(ls -d "$JAVA_DIR"/lux-*/target/lux-*.jar | tr '\n' ':')"
    azul "creando $2…"
    java -cp "$cp" lux.web.Nuevo "${@:2}"
    ;;

  dist|paquete)
    # Arma lo que se baja el instalador: el código fuente, sin target/ y sin la web.
    # Va dentro de los recursos de lux-web, así que se despliega con el propio sitio y no
    # hay un segundo sitio del que acordarse.
    v=$(version)
    destino="$JAVA_DIR/lux-web/src/main/resources/estaticos"
    guiones="$JAVA_DIR/lux-web/src/main/resources/guiones"
    mkdir -p "$destino" "$guiones"
    cp "$AQUI/docs/instalar.sh" "$AQUI/docs/instalar.ps1" "$guiones/"

    # Antes de copiar nada: si quedaran los paquetes de la vez anterior, el nuevo se los
    # llevaría dentro y engordaría en cada pasada.
    rm -f "$destino"/luxcore-*.tar.gz "$destino"/luxcore-*.zip "$destino"/luxcore-*.sha256

    tmp=$(mktemp -d)
    mkdir -p "$tmp/luxcore-$v"
    # COPYFILE_DISABLE evita que el tar de macOS meta un ._archivo por cada archivo.
    COPYFILE_DISABLE=1 tar -cf - \
        --exclude target --exclude '*.class' --exclude .DS_Store --exclude classpath.txt \
        --exclude 'luxcore-*.tar.gz' --exclude 'luxcore-*.zip' --exclude 'luxcore-*.sha256' \
        -C "$AQUI" java lux lux.cmd lux.ps1 LICENSE NOTICE README.md \
      | tar -xf - -C "$tmp/luxcore-$v"
    COPYFILE_DISABLE=1 tar -czf "$destino/luxcore-$v.tar.gz" -C "$tmp" "luxcore-$v"
    # jar en vez de zip: el JDK ya está, y `zip` no siempre.
    (cd "$tmp" && jar --create --file "$destino/luxcore-$v.zip" "luxcore-$v")
    rm -rf "$tmp"

    for f in "$destino/luxcore-$v.tar.gz" "$destino/luxcore-$v.zip"; do
      if command -v shasum >/dev/null; then shasum -a 256 "$f"; else sha256sum "$f"; fi \
        | sed "s| .*| $(basename "$f")|" > "$f.sha256"
      printf '  %-26s %6s KB\n' "$(basename "$f")" "$(( $(wc -c < "$f") / 1024 ))"
    done
    gris "  huellas en .sha256 · los sirve lux-web en /estaticos/"
    ;;

  run|correr)
    requisitos
    azul "compilando la aplicación de ejemplo…"
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    azul "arrancando en http://localhost:${2:-8080}"
    java -cp "$(classpath_ejemplo)" ejemplo.App "${2:-8080}"
    ;;

  test|probar)
    requisitos
    if [ -n "${2:-}" ]; then
      azul "probando $2"
      (cd "$JAVA_DIR" && mvn -B -o -q -pl "$2" -am test)
    else
      azul "corriendo todas las pruebas"
      (cd "$JAVA_DIR" && mvn -B -q test)
    fi
    ;;

  package|empaquetar)
    requisitos
    azul "empaquetando…"
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests package)
    echo
    printf '  %-22s %10s\n' MÓDULO TAMAÑO
    local_total=0
    for m in $(modulos); do
      jar=$(ls "$JAVA_DIR/$m/target/$m"-*.jar 2>/dev/null | head -1) || continue
      [ -n "$jar" ] || continue
      bytes=$(wc -c < "$jar" | tr -d ' ')
      local_total=$((local_total + bytes))
      printf '  %-22s %7s KB\n' "$m" "$((bytes / 1024))"
    done
    printf '  %-22s %7s KB\n' "total" "$((local_total / 1024))"
    ;;

  install|instalar)
    requisitos
    azul "compilando, probando e instalando en ~/.m2"
    (cd "$JAVA_DIR" && mvn -B install)
    ;;

  clean|limpiar)
    azul "borrando lo generado…"
    (cd "$JAVA_DIR" && "${MVN[@]}" clean) || true
    rm -rf "$JAVA_DIR"/*/target "$AQUI"/legacy/*/target 2>/dev/null || true
    find "$AQUI" -name '*.class' -not -path '*/.git/*' -delete 2>/dev/null || true
    gris "listo"
    ;;

  cache)
    if [ "${2:-}" = "--purge" ]; then
      azul "vaciando la caché de LuxCore en ~/.m2…"
      rm -rf "$HOME/.m2/repository/lux"
      gris "artefactos de lux eliminados; la próxima compilación los rehace"
    else
      printf '  %-34s %10s\n' UBICACIÓN TAMAÑO
      for d in "$HOME/.m2/repository/lux" "$JAVA_DIR"/*/target "$AQUI/legacy"/*/target; do
        [ -d "$d" ] || continue
        printf '  %-34s %10s\n' "${d/#$AQUI/.}" "$(du -sh "$d" 2>/dev/null | cut -f1)"
      done
      echo
      gris "  ./lux cache --purge    vacía los artefactos de lux en ~/.m2"
      gris "  ./lux clean            borra los target/ del proyecto"
    fi
    ;;

  docs|web)
    requisitos
    puerto="${2:-8095}"
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    cp=$(ls -d "$JAVA_DIR"/lux-*/target/lux-*.jar | tr '\n' ':')
    tmp=$(mktemp -d)
    cat > "$tmp/Sitio.java" <<'JAVA'
import lux.core.Lux;
import lux.http.StaticFiles;
import java.nio.file.Path;

public class Sitio {
    public static void main(String[] args) throws Exception {
        Lux.app().port(Integer.parseInt(args[1]))
           .fallback(StaticFiles.from(Path.of(args[0])))
           .start().await();
    }
}
JAVA
    javac -cp "$cp" -d "$tmp" "$tmp/Sitio.java"
    azul "sirviendo la documentación estática en http://localhost:$puerto"
    java -cp "$cp:$tmp" Sitio "$AQUI/docs/web" "$puerto"
    ;;

  fatjar)
    requisitos
    modulo="${2:-ejemplo}"
    main="${3:-}"
    if [ -z "$main" ]; then
      case "$modulo" in
        ejemplo) main="ejemplo.App" ;;
        lux-web) main="lux.web.App" ;;
        *) malo "dime la clase principal: ./lux fatjar <modulo> <clase>"; exit 1 ;;
      esac
    fi
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    (cd "$JAVA_DIR/$modulo" && "${MVN[@]}" dependency:build-classpath \
        -Dmdep.outputFile=target/classpath.txt >/dev/null)
    destino="$AQUI/$modulo.jar"
    java -cp "$JAVA_DIR/lux-launcher/target/classes" lux.launcher.Packager \
         --main "$main" --out "$destino" \
         "$JAVA_DIR/$modulo/target/classes" \
         $(tr ':' '\n' < "$JAVA_DIR/$modulo/target/classpath.txt")
    azul "arráncalo con:  java -jar $(basename "$destino")"
    ;;

  portal)
    requisitos
    puerto="${2:-8080}"
    azul "compilando el sitio…"
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    cp="$JAVA_DIR/lux-web/target/classes:$(ls -d "$JAVA_DIR"/lux-*/target/lux-*.jar | tr '\n' ':')"
    azul "arrancando el sitio en http://localhost:$puerto"
    java -cp "$cp" lux.web.App "$puerto"
    ;;

  build|sitio)
    azul "regenerando las páginas…"
    python3 "$AQUI/docs/web/construir.py"
    python3 "$AQUI/docs/web/a-plantillas.py"
    ;;

  status|estado)
    printf '  %-16s %s\n' versión "$(grep -m1 '<version>' "$JAVA_DIR/pom.xml" | sed 's/.*<version>\(.*\)<.*/\1/')"
    printf '  %-16s %s\n' java "$(java -version 2>&1 | head -1 | cut -d'"' -f2)"
    printf '  %-16s %s clases, %s líneas\n' código \
      "$(find "$JAVA_DIR" -path '*/src/main/*' -name '*.java' | wc -l | tr -d ' ')" \
      "$(find "$JAVA_DIR" -path '*/src/main/*' -name '*.java' -exec cat {} + | wc -l | tr -d ' ')"
    printf '  %-16s %s líneas\n' pruebas \
      "$(find "$JAVA_DIR" -path '*/src/test/*' -name '*.java' -exec cat {} + | wc -l | tr -d ' ')"
    printf '  %-16s %s\n' dependencias \
      "$(grep -rl 'jakarta\|springframework' "$JAVA_DIR"/lux-http/src/main "$JAVA_DIR"/lux-core/src/main 2>/dev/null | wc -l | tr -d ' ') externas en el núcleo"
    printf '  %-16s %s\n' repositorio "$(git -C "$AQUI" rev-parse --short HEAD 2>/dev/null || echo '—')"
    ;;

  *)
    azul "lux — órdenes de LuxCore"
    echo
    printf '  %-24s %s\n' "./lux new <nombre>"     "crea un proyecto nuevo y listo para arrancar"
    printf '  %-24s %s\n' "./lux run [puerto]"     "arranca la aplicación de ejemplo"
    printf '  %-24s %s\n' "./lux test [módulo]"    "corre las pruebas"
    printf '  %-24s %s\n' "./lux package"          "genera los JAR y muestra sus tamaños"
    printf '  %-24s %s\n' "./lux fatjar [módulo]"  "un solo jar ejecutable con java -jar"
    printf '  %-24s %s\n' "./lux install"          "compila, prueba e instala en ~/.m2"
    printf '  %-24s %s\n' "./lux dist"             "arma el .tar.gz y el .zip del instalador"
    printf '  %-24s %s\n' "./lux clean"            "borra lo generado"
    printf '  %-24s %s\n' "./lux cache [--purge]"  "qué ocupa la caché, o vaciarla"
    printf '  %-24s %s\n' "./lux docs [puerto]"    "sirve la documentación estática"
    printf '  %-24s %s\n' "./lux portal [puerto]"  "arranca lux-web: acceso, demos y generador"
    printf '  %-24s %s\n' "./lux build"            "regenera las páginas del sitio"
    printf '  %-24s %s\n' "./lux status"           "resumen del proyecto"
    ;;
esac
