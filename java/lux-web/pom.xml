<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>lux</groupId>
        <artifactId>lux-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>lux-web</artifactId>
    <packaging>jar</packaging>
    <name>lux-web</name>

    <dependencies>
        <dependency>
            <groupId>lux</groupId>
            <artifactId>lux-core</artifactId>
            <version>0.2.0</version>
        </dependency>
        <dependency>
            <groupId>lux</groupId>
            <artifactId>lux-view</artifactId>
            <version>0.2.0</version>
        </dependency>
        <dependency>
            <groupId>lux</groupId>
            <artifactId>lux-data</artifactId>
            <version>0.2.0</version>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Solo esto se filtra: así la versión que anuncia /version sale del pom y no
                 hay un número más que acordarse de subir a mano. -->
            <resource>
                <directory>src/main/filtrado</directory>
                <filtering>true</filtering>
            </resource>
            <!-- Los guiones del instalador se sirven desde el classpath, pero viven en docs/ y
                 son su único original. Copiarlos aquí a mano dejaba dos versiones y, peor, en un
                 checkout limpio no existían y las pruebas de /instalar fallaban. -->
            <resource>
                <directory>${project.basedir}/../../docs</directory>
                <targetPath>guiones</targetPath>
                <includes>
                    <include>instalar.sh</include>
                    <include>instalar.ps1</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>lux.web.TestSuite</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
