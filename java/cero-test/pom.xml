<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.ginit.cero</groupId>
        <artifactId>cero-parent</artifactId>
        <version>0.7.0</version>
    </parent>

    <artifactId>cero-test</artifactId>
    <packaging>jar</packaging>
    <name>cero-test</name>
    <description>Testing support for Cero applications: start the app on a free port, an HTTP client that keeps cookies across requests, and readable assertions on the response. No dependencies outside the JDK.</description>

    <dependencies>
        <dependency>
            <groupId>dev.ginit.cero</groupId>
            <artifactId>cero-core</artifactId>
            <version>0.7.0</version>
        </dependency>

        <!-- solo lo necesita TestDatabase: una aplicación sin base de datos no arrastra cero-data -->
        <dependency>
            <groupId>dev.ginit.cero</groupId>
            <artifactId>cero-data</artifactId>
            <version>0.7.0</version>
            <optional>true</optional>
        </dependency>

        <!-- base desechable para probar TestDatabase; cero-test no depende de ningún driver -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>run-tests</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${skipTests}</skip>
                            <executable>java</executable>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>cero.test.TestSuite</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
