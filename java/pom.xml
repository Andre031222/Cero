<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.ginit.cero</groupId>
    <artifactId>cero-parent</artifactId>
    <version>0.6.0</version>
    <packaging>pom</packaging>
    <name>Cero</name>
    <description>Web framework for Java 25. Its own HTTP server, one virtual thread per connection, and zero runtime dependencies.</description>
    <url>https://cero.ginit.dev</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Richar Andre Vilca-Solorzano</name>
            <url>https://orcid.org/0009-0003-2385-5263</url>
            <organization>Universidad Nacional del Altiplano</organization>
        </developer>
        <developer>
            <name>Ramiro Pedro Laura-Murillo</name>
            <url>https://orcid.org/0000-0003-1837-4871</url>
            <organization>Universidad Nacional del Altiplano</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Andre031222/Cero.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Andre031222/Cero.git</developerConnection>
        <url>https://github.com/Andre031222/Cero</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>cero-http</module>
        <module>cero-core</module>
        <module>cero-view</module>
        <module>cero-data</module>
        <module>cero-adapter-servlet</module>
        <module>ejemplo</module>
        <module>cero-launcher</module>
        <module>cero-web</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <skipTests>false</skipTests>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- Publicar en Maven Central pide cuatro cosas que el build normal no hace: jar de fuentes,
         jar de javadoc, firma GPG y el plugin de publicación. Van en un perfil y no en el build
         de siempre porque firmar exige una clave privada: fuera de una publicación, cada `mvn
         install` pediría la contraseña, y en integración continua fallaría directamente.

             mvn -Ppublicar deploy

         Lo que no puede estar aquí y hay que tener puesto una vez: la cuenta en Central, la clave
         GPG publicada en un servidor de claves, y las credenciales en ~/.m2/settings.xml bajo el
         id `central`. -->
    <profiles>
        <profile>
            <id>publicar</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>adjuntar-fuentes</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>adjuntar-javadoc</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- El javadoc está en castellano y con acentos: sin esto, en una
                                 máquina con otra configuración regional sale con caracteres rotos. -->
                            <encoding>UTF-8</encoding>
                            <docencoding>UTF-8</docencoding>
                            <charset>UTF-8</charset>
                            <!-- Sin `locale`: la prosa del javadoc está en castellano y ahí no
                                 hay nada que hacer, pero forzando es_ES también salían en
                                 castellano la navegación y los títulos que genera la
                                 herramienta. Quien llega desde Maven Central sin saber
                                 castellano al menos puede recorrer la estructura. -->
                            <doclint>none</doclint>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>firmar</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Sin autoPublish: sube al portal y espera. La primera vez conviene
                                 mirar lo que se subió antes de que sea irreversible — una versión
                                 publicada en Central no se puede borrar ni rehacer. -->
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
