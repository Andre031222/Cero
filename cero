#!/usr/bin/env bash
set -euo pipefail

AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAVA_DIR="$AQUI/java"
MVN=(mvn -B -q)

case "${COLORTERM:-}" in
  truecolor|24bit) MARCA='\033[38;2;56;189;248m' ;;
  *)               MARCA='\033[38;5;75m' ;;
esac
azul()  { printf "$MARCA%s\033[0m\n" "$*"; }

case "${CERO_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}}" in
  es*|ES*) IDIOMA=es ;;
  *)       IDIOMA=en ;;
esac

t() {
  local k=$1; shift
  local v
  if [ "$IDIOMA" = es ]; then v=$(texto_es "$k"); else v=$(texto_en "$k"); [ -z "$v" ] && v=$(texto_es "$k"); fi
  [ -z "$v" ] && v="$k"
  printf "$v" "$@"
}

texto_es() {
  case "$1" in
    falta-maven)      printf '%s' 'falta Maven' ;;
    falta-jdk)        printf '%s' 'falta un JDK' ;;
    java-viejo)       printf '%s' 'Cero necesita Java 25 o superior (hilos virtuales); tienes %s' ;;
    jdk-afectado)     printf '%s' 'nota: no se puede confirmar que el JDK %s traiga la corrección de CVE-2026-91403, porque el aviso de OpenJDK no nombra todavía ninguna versión corregida; usa la build más reciente de tu proveedor y consulta https://openjdk.org/groups/vulnerability/advisories/2026-10-21' ;;
    creando)          printf '%s' 'creando %s…' ;;
    dime-nombre)      printf '%s' 'dime el nombre:  cero new mi-app [grupo] [motor]' ;;
    compilando-ej)    printf '%s' 'compilando la aplicación de ejemplo…' ;;
    arrancando)       printf '%s' 'arrancando en http://localhost:%s' ;;
    probando)         printf '%s' 'probando %s' ;;
    todas-pruebas)    printf '%s' 'corriendo todas las pruebas' ;;
    empaquetando)     printf '%s' 'empaquetando…' ;;
    instalando)       printf '%s' 'compilando, probando e instalando en ~/.m2' ;;
    borrando)         printf '%s' 'borrando lo generado…' ;;
    listo)            printf '%s' 'listo' ;;
    arrancalo-con)    printf '%s' 'arráncalo con:  java -Xmx64m -jar %s' ;;
    dist-limpio)      printf '%s' 'compilando desde cero, que es como lo va a compilar quien lo instale…' ;;
    dist-no-compila)  printf '%s' 'no compila desde cero: no se empaqueta' ;;
    dist-probando)    printf '%s' 'probando el paquete recién armado, no el repositorio…' ;;
    dist-pasa)        printf '%s' '  el paquete pasa sus propias pruebas' ;;
    dist-no-pasa)     printf '%s' 'el paquete NO pasa sus pruebas — no se publica' ;;
    dist-huellas)     printf '%s' '  huellas en .sha256 · en %s' ;;
    cache-vaciando)   printf '%s' 'vaciando la caché de Cero en ~/.m2…' ;;
    cache-hecho)      printf '%s' 'artefactos de cero eliminados; la próxima compilación los rehace' ;;
    falta-clase)      printf '%s' 'dime la clase principal: ./cero fatjar <modulo> <clase>' ;;
    falta-driver)     printf '%s' 'hace falta un driver JDBC: exporta CERO_JDBC_JAR=/ruta/driver.jar' ;;
    no-carpeta)       printf '%s' 'no existe la carpeta %s' ;;
    no-migraciones)   printf '%s' 'no existe el directorio de migraciones %s' ;;
    git-sucio)        printf '%s' 'el árbol de git de %s tiene cambios sin guardar.' ;;
    git-commitea)     printf '%s' 'commitea o guarda antes: la migración usa git como red de seguridad.' ;;
    uso-migrar)       printf '%s' 'uso: ./cero migrar <ruta-de-la-app> [--probar]' ;;
    uso-migraciones)  printf '%s' 'uso: ./cero migraciones --verificar [directorio] [url-jdbc]' ;;
    ver-comprobando)  printf '%s' 'comprobando %s…' ;;
    ver-falta)        printf '%s' 'falta %s' ;;
    ver-sin-python)   printf '%s' 'falta Python 3.12 o superior (python3.14, python3.12 o python3): lo que lo necesita sale ✗' ;;
    ver-python)       printf '%s' 'python: %s (%s)' ;;
    ver-ocupado)      printf '%s' 'el puerto %s ya está ocupado' ;;
    ver-no-arranca)   printf '%s' 'el servidor no llegó a escuchar' ;;
    ver-sin-hallazgos) printf '%s' 'sin hallazgos' ;;
    ver-hallazgos)    printf '%s' '%s líneas de hallazgos' ;;
    ver-ninguno)      printf '%s' 'ningún comentario' ;;
    ver-comentarios)  printf '%s' '%s comentarios' ;;
    ver-pruebas)      printf '%s' 'pruebas' ;;
    ver-n-pruebas)    printf '%s' '%s pruebas' ;;
    ver-sin-motores)  printf '%s' 'motores reales sin probar (CI lo exige)' ;;
    ver-omitido)      printf '%s' 'omitido a pedido' ;;
    ver-no-ci)        printf '%s' 'lo demás está bien, pero esta corrida NO equivale a CI: motores reales omitidos a pedido' ;;
    ver-sin-vectores) printf '%s' 'sin resumen del banco' ;;
    ver-n-orden)      printf '%s' 'orden' ;;
    ver-n-coment)     printf '%s' 'comentarios' ;;
    ver-n-vectores)   printf '%s' '%s vectores' ;;
    ver-banco)        printf '%s' 'banco' ;;
    ver-ataques)      printf '%s' 'ataques' ;;
    ver-requisitos)   printf '%s' 'requisitos' ;;
    ver-de-minimo)    printf '%s' '%s (mínimo %s)' ;;
    ver-sin-resumen)  printf '%s' 'h2spec no dio resumen' ;;
    ver-detalle)      printf '%s' 'lo último que dijo «%s»:' ;;
    ver-todo-bien)    printf '%s' 'todo está bien' ;;
    ver-fallan)       printf '%s' '%s comprobaciones fallan' ;;
    ayuda-titulo)     printf '%s' 'cero — órdenes de Cero' ;;
    *)                printf '%s' '' ;;
  esac
}

texto_en() {
  case "$1" in
    falta-maven)      printf '%s' 'Maven is missing' ;;
    falta-jdk)        printf '%s' 'a JDK is missing' ;;
    java-viejo)       printf '%s' 'Cero needs Java 25 or newer (virtual threads); you have %s' ;;
    jdk-afectado)     printf '%s' 'note: it cannot be confirmed that JDK %s carries the fix for CVE-2026-91403, because the OpenJDK advisory names no fixed version yet; use the newest build from your vendor and see https://openjdk.org/groups/vulnerability/advisories/2026-10-21' ;;
    creando)          printf '%s' 'creating %s…' ;;
    dime-nombre)      printf '%s' 'give it a name:  cero new my-app [group] [engine]' ;;
    compilando-ej)    printf '%s' 'building the example application…' ;;
    arrancando)       printf '%s' 'starting on http://localhost:%s' ;;
    probando)         printf '%s' 'testing %s' ;;
    todas-pruebas)    printf '%s' 'running every test' ;;
    empaquetando)     printf '%s' 'packaging…' ;;
    instalando)       printf '%s' 'building, testing and installing into ~/.m2' ;;
    borrando)         printf '%s' 'removing build output…' ;;
    listo)            printf '%s' 'done' ;;
    arrancalo-con)    printf '%s' 'run it with:  java -Xmx64m -jar %s' ;;
    dist-limpio)      printf '%s' 'building from scratch, the way whoever installs it will…' ;;
    dist-no-compila)  printf '%s' 'it does not build from scratch: not packaging' ;;
    dist-probando)    printf '%s' 'testing the package just built, not the repository…' ;;
    dist-pasa)        printf '%s' '  the package passes its own tests' ;;
    dist-no-pasa)     printf '%s' 'the package does NOT pass its tests — not publishing' ;;
    dist-huellas)     printf '%s' '  checksums in .sha256 · in %s' ;;
    cache-vaciando)   printf '%s' 'clearing the Cero cache in ~/.m2…' ;;
    cache-hecho)      printf '%s' 'cero artifacts removed; the next build will rebuild them' ;;
    falta-clase)      printf '%s' 'give it a main class: ./cero fatjar <module> <class>' ;;
    falta-driver)     printf '%s' 'a JDBC driver is needed: export CERO_JDBC_JAR=/path/driver.jar' ;;
    no-carpeta)       printf '%s' 'no such directory: %s' ;;
    no-migraciones)   printf '%s' 'no such migrations directory: %s' ;;
    git-sucio)        printf '%s' 'the git tree at %s has unsaved changes.' ;;
    git-commitea)     printf '%s' 'commit or stash first: the migration uses git as its safety net.' ;;
    uso-migrar)       printf '%s' 'usage: ./cero migrar <app-path> [--probar]' ;;
    uso-migraciones)  printf '%s' 'usage: ./cero migraciones --verificar [directory] [jdbc-url]' ;;
    ver-comprobando)  printf '%s' 'checking %s…' ;;
    ver-falta)        printf '%s' 'missing: %s' ;;
    ver-sin-python)   printf '%s' 'Python 3.12 or newer is missing (python3.14, python3.12 or python3): whatever needs it shows ✗' ;;
    ver-python)       printf '%s' 'python: %s (%s)' ;;
    ver-ocupado)      printf '%s' 'port %s is already in use' ;;
    ver-no-arranca)   printf '%s' 'the server never started listening' ;;
    ver-sin-hallazgos) printf '%s' 'no findings' ;;
    ver-hallazgos)    printf '%s' '%s lines of findings' ;;
    ver-ninguno)      printf '%s' 'no comments' ;;
    ver-comentarios)  printf '%s' '%s comments' ;;
    ver-pruebas)      printf '%s' 'tests' ;;
    ver-n-pruebas)    printf '%s' '%s tests' ;;
    ver-sin-motores)  printf '%s' 'real engines untested (CI requires them)' ;;
    ver-omitido)      printf '%s' 'skipped on request' ;;
    ver-no-ci)        printf '%s' 'the rest is fine, but this run is NOT equivalent to CI: real engines skipped on request' ;;
    ver-sin-vectores) printf '%s' 'no bench summary' ;;
    ver-n-orden)      printf '%s' 'order' ;;
    ver-n-coment)     printf '%s' 'comments' ;;
    ver-n-vectores)   printf '%s' '%s vectors' ;;
    ver-banco)        printf '%s' 'bench' ;;
    ver-ataques)      printf '%s' 'attacks' ;;
    ver-requisitos)   printf '%s' 'requirements' ;;
    ver-de-minimo)    printf '%s' '%s (minimum %s)' ;;
    ver-sin-resumen)  printf '%s' 'h2spec gave no summary' ;;
    ver-detalle)      printf '%s' 'the last thing «%s» said:' ;;
    ver-todo-bien)    printf '%s' 'everything is fine' ;;
    ver-fallan)       printf '%s' '%s checks fail' ;;
    ayuda-titulo)     printf '%s' 'cero — Cero commands' ;;
    *)                printf '%s' '' ;;
  esac
}
gris()  { printf '\033[38;5;245m%s\033[0m\n' "$*"; }
malo()  { printf '\033[38;5;167m%s\033[0m\n' "$*" >&2; }

requisitos() {
  command -v mvn >/dev/null || { malo "$(t falta-maven)"; exit 1; }
  command -v java >/dev/null || { malo "$(t falta-jdk)"; exit 1; }
  local v
  v=$(java -version 2>&1 | head -1 | sed -E 's/.*"([0-9]+).*/\1/')
  if [ "${v:-0}" -lt 25 ] 2>/dev/null; then
    malo "$(t java-viejo "$v")"
    exit 1
  fi
  v=$(java -version 2>&1 | head -1 | sed -E 's/[^"]*"([^"]*)".*/\1/')
  if jdk_afectado "$v"; then gris "$(t jdk-afectado "$v")" >&2; fi
}

jdk_afectado() {
  local mayor parche
  mayor=$(printf '%s' "$1" | cut -d. -f1)
  parche=$(printf '%s' "$1" | cut -s -d. -f3 | sed 's/[^0-9].*//')
  case "$mayor" in
    25) [ "${parche:-0}" -le 5 ] ;;
    26) return 0 ;;
    27) [ "${parche:-0}" -le 1 ] ;;
    *) return 1 ;;
  esac
}

modulos() { echo "cero-http cero-core cero-data cero-adapter-servlet"; }

classpath_ejemplo() {
  local destino="$JAVA_DIR/ejemplo/target/classpath.txt"
  if [ ! -f "$destino" ] || [ "$JAVA_DIR/ejemplo/pom.xml" -nt "$destino" ]; then
    (cd "$JAVA_DIR/ejemplo" && "${MVN[@]}" dependency:build-classpath \
        -Dmdep.outputFile=target/classpath.txt >/dev/null)
  fi
  echo "$JAVA_DIR/ejemplo/target/classes:$(cat "$destino")"
}

version() { grep -m1 '<version>' "$JAVA_DIR/pom.xml" | sed 's/.*<version>\(.*\)<.*/\1/'; }

IMPLEMENTACIONES='
java|java|mvn java|mvn -B install||java -cp cero-http/target/classes:cero-http/target/test-classes cero.http.Conforme||
rust|rust|cargo|cargo test --all && cargo clippy --all-targets -- -D warnings|cargo build --release --bin conforme|./target/release/conforme|cero-http/tests cero-data/tests|159
c++|c++|cmake ctest|cmake -S . -B "$OBJ" -DCMAKE_BUILD_TYPE=Release && cmake --build "$OBJ" -j && ctest --test-dir "$OBJ" --output-on-failure||"$OBJ/conforme"|pruebas|157
'

V_PUERTO="${CERO_PUERTO:-8777}"
V_PID=""
V_TMP=""
V_PY=""
V_SIN_MOTORES=0
V_NOMBRES=()
V_CIFRAS=()
V_ESTADOS=()
V_REGISTROS=()

buscar_python() {
  local p
  for p in python3.14 python3.13 python3.12 python3; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2>/dev/null; then
      command -v "$p"
      return 0
    fi
  done
  return 1
}

faltan() {
  local h salida=""
  for h in "$@"; do
    if [ "$h" = python3 ]; then
      [ -n "$V_PY" ] || salida="$salida python3.12"
    else
      command -v "$h" >/dev/null 2>&1 || salida="$salida $h"
    fi
  done
  printf '%s' "${salida# }"
}

anotar() {
  V_NOMBRES+=("$1")
  V_CIFRAS+=("$2")
  V_ESTADOS+=("$3")
  V_REGISTROS+=("${4:-}")
}

anotar_falta() {
  anotar "$1" "$(t ver-falta "$2")" mal
}

ejecutar() {
  local rc=0
  (cd "$1" && eval "$2") </dev/null >>"$3" 2>&1 || rc=$?
  return $rc
}

contar_pruebas() {
  awk '
    /^  OK / { n++ }
    /^test result: / { for (i = 1; i <= NF; i++) if ($i == "passed;") n += $(i - 1) }
    /tests passed, .* out of/ { n += $NF }
    END { print n + 0 }' "$1"
}

cifra_vectores() {
  local n
  n=$(grep -E ' vectores ·' "$1" | tail -n 1 | sed -E 's/^ *([0-9]+) vectores · ([0-9]+) pasan.*/\2\/\1/')
  if [ -n "$n" ]; then t ver-n-vectores "$n"; else t ver-sin-vectores; fi
}

carpetas_codigo() {
  printf '%s' "$IMPLEMENTACIONES" | awk -F'|' 'NF > 1 { printf "%s ", $2 }'
  printf 'herramientas'
}

arrancar_servidor() {
  local i
  (cd "$1" && eval "exec $2 $V_PUERTO") </dev/null >"$3" 2>&1 &
  V_PID=$!
  disown "$V_PID"
  for i in $(seq 30); do
    if curl -fsS -o /dev/null "http://127.0.0.1:$V_PUERTO/" 2>/dev/null; then return 0; fi
    kill -0 "$V_PID" 2>/dev/null || return 1
    sleep 1
  done
  return 1
}

parar_servidor() {
  if [ -n "$V_PID" ]; then
    kill "$V_PID" 2>/dev/null || true
    for _ in 1 2 3 4 5; do
      kill -0 "$V_PID" 2>/dev/null || break
      sleep 1
    done
    kill -9 "$V_PID" 2>/dev/null || true
    wait "$V_PID" 2>/dev/null || true
  fi
  V_PID=""
}

limpiar_verificar() {
  parar_servidor
  [ -z "$V_TMP" ] || rm -rf "$V_TMP"
}

con_servidor() {
  if curl -s -o /dev/null --max-time 2 "http://127.0.0.1:$V_PUERTO/" 2>/dev/null; then
    anotar "$1" "$(t ver-ocupado "$V_PUERTO")" mal
    return 1
  fi
  if ! arrancar_servidor "$2" "$3" "$4"; then
    parar_servidor
    anotar "$1" "$(t ver-no-arranca)" mal "$4"
    return 1
  fi
}

paso_orden() {
  local f
  azul "$(t ver-comprobando orden)"
  f=$(faltan git python3)
  if [ -n "$f" ]; then
    anotar_falta "$(t ver-n-orden)" "$f"
  else
    : >"$V_TMP/orden.log"
    if ejecutar "$AQUI" ./herramientas/verificar-orden.sh "$V_TMP/orden.log"; then
      anotar "$(t ver-n-orden)" "$(t ver-sin-hallazgos)" ok
    else
      anotar "$(t ver-n-orden)" "$(t ver-hallazgos "$(grep -c . "$V_TMP/orden.log")")" mal "$V_TMP/orden.log"
    fi
  fi

  azul "$(t ver-comprobando comentarios)"
  f=$(faltan python3)
  if [ -n "$f" ]; then
    anotar_falta "$(t ver-n-coment)" "$f"
    return
  fi
  : >"$V_TMP/comentarios.log"
  if ejecutar "$AQUI" "python3 herramientas/comentarios.py --verificar $(carpetas_codigo) && python3 -I herramientas/pruebas_comentarios.py" "$V_TMP/comentarios.log"; then
    anotar "$(t ver-n-coment)" "$(t ver-ninguno)" ok
  else
    anotar "$(t ver-n-coment)" "$(t ver-comentarios "$(grep -cE '^[^ ]+:[0-9]+' "$V_TMP/comentarios.log" || true)")" mal "$V_TMP/comentarios.log"
  fi
}

paso_pruebas() {
  local nombre dir herr probar preparar servidor req minimo f registro cifra rc
  while IFS='|' read -u 3 -r nombre dir herr probar preparar servidor req minimo; do
    [ -n "$nombre" ] || continue
    azul "$(t ver-comprobando "$nombre")"
    f=$(faltan $herr)
    if [ -n "$f" ]; then anotar_falta "$nombre · $(t ver-pruebas)" "$f"; continue; fi
    registro="$V_TMP/$nombre-pruebas.log"
    : >"$registro"
    export OBJ="$V_TMP/obj-$nombre"
    rc=0
    ejecutar "$AQUI/$dir" "$probar" "$registro" || rc=1
    if [ -n "$preparar" ]; then ejecutar "$AQUI/$dir" "$preparar" "$registro" || rc=1; fi
    cifra=$(t ver-n-pruebas "$(contar_pruebas "$registro")")
    if [ "$rc" = 0 ] && grep -q 'no está accesible' "$registro"; then
      if [ "$V_SIN_MOTORES" = 1 ]; then
        anotar "$nombre · $(t ver-pruebas)" "$cifra · $(t ver-omitido)" omitido
      else
        anotar "$nombre · $(t ver-pruebas)" "$cifra · $(t ver-sin-motores)" mal "$registro"
      fi
    elif [ "$rc" = 0 ]; then anotar "$nombre · $(t ver-pruebas)" "$cifra" ok
    else anotar "$nombre · $(t ver-pruebas)" "$cifra" mal "$registro"; fi
  done 3<<<"$IMPLEMENTACIONES"
}

paso_banco() {
  local nombre dir herr probar preparar servidor req minimo f registro etiqueta
  while IFS='|' read -u 3 -r nombre dir herr probar preparar servidor req minimo; do
    [ -n "$nombre" ] || continue
    export OBJ="$V_TMP/obj-$nombre"

    etiqueta="$(t ver-banco) · $nombre"
    azul "$(t ver-comprobando "$etiqueta")"
    f=$(faltan python3 curl $herr)
    if [ -n "$f" ]; then
      anotar_falta "$etiqueta" "$f"
    else
      registro="$V_TMP/$nombre-banco.log"
      if con_servidor "$etiqueta" "$AQUI/$dir" "$servidor" "$V_TMP/$nombre-servidor.log"; then
        if python3 "$AQUI/spec/banco/correr.py" 127.0.0.1 "$V_PUERTO" </dev/null >"$registro" 2>&1; then
          anotar "$etiqueta" "$(cifra_vectores "$registro")" ok
        else
          anotar "$etiqueta" "$(cifra_vectores "$registro")" mal "$registro"
        fi
        parar_servidor
      fi
    fi

    etiqueta="$(t ver-ataques) · $nombre"
    azul "$(t ver-comprobando "$etiqueta")"
    f=$(faltan python3 $herr)
    if [ -n "$f" ]; then
      anotar_falta "$etiqueta" "$f"
    else
      registro="$V_TMP/$nombre-ataques.log"
      if (cd "$AQUI/$dir" && eval "python3 \"$AQUI/spec/banco/ataques.py\" $servidor") </dev/null >"$registro" 2>&1; then
        anotar "$etiqueta" "$(cifra_vectores "$registro")" ok
      else
        anotar "$etiqueta" "$(cifra_vectores "$registro")" mal "$registro"
      fi
    fi
  done 3<<<"$IMPLEMENTACIONES"
}

paso_h2spec() {
  local nombre dir herr probar preparar servidor req minimo f registro resumen fallos etiqueta
  while IFS='|' read -u 3 -r nombre dir herr probar preparar servidor req minimo; do
    [ -n "$nombre" ] || continue
    etiqueta="h2spec · $nombre"
    azul "$(t ver-comprobando "$etiqueta")"
    f=$(faltan h2spec curl $herr)
    if [ -n "$f" ]; then anotar_falta "$etiqueta" "$f"; continue; fi
    export OBJ="$V_TMP/obj-$nombre"
    registro="$V_TMP/$nombre-h2spec.log"
    if con_servidor "$etiqueta" "$AQUI/$dir" "$servidor" "$V_TMP/$nombre-servidor-h2.log"; then
      h2spec -h 127.0.0.1 -p "$V_PUERTO" --timeout 5 </dev/null >"$registro" 2>&1 || true
      parar_servidor
      resumen=$(grep -E '^[0-9]+ tests,' "$registro" | tail -n 1 || true)
      fallos=$(printf '%s' "$resumen" | sed -E 's/.*, ([0-9]+) failed.*/\1/')
      case "$fallos" in ''|*[!0-9]*) fallos=99 ;; esac
      if [ "$fallos" -le 1 ]; then anotar "$etiqueta" "$resumen" ok
      else anotar "$etiqueta" "${resumen:-$(t ver-sin-resumen)}" mal "$registro"; fi
    fi
  done 3<<<"$IMPLEMENTACIONES"
}

paso_requisitos() {
  local nombre dir herr probar preparar servidor req minimo n
  while IFS='|' read -u 3 -r nombre dir herr probar preparar servidor req minimo; do
    [ -n "$nombre" ] && [ -n "$minimo" ] || continue
    azul "$(t ver-comprobando "$(t ver-requisitos) $nombre")"
    n=$(cd "$AQUI/$dir" && grep -rhoiE '(HTTP|OBS|RUT|SEG|SES|H2)[-_][0-9]{3}' $req | tr a-z_ A-Z- | sort -u | wc -l | tr -d ' ')
    if [ "$n" -ge "$minimo" ]; then anotar "$(t ver-requisitos) · $nombre" "$(t ver-de-minimo "$n" "$minimo")" ok
    else anotar "$(t ver-requisitos) · $nombre" "$(t ver-de-minimo "$n" "$minimo")" mal; fi
  done 3<<<"$IMPLEMENTACIONES"
}

rellenar() {
  local n=${#1}
  printf '%s' "$1"
  while [ "$n" -lt "$2" ]; do printf ' '; n=$((n + 1)); done
}

tabla_verificar() {
  local i fallos=0 omitidos=0 verde='' rojo='' fin=''
  if [ -t 1 ]; then verde='\033[38;5;71m'; rojo='\033[38;5;167m'; fin='\033[0m'; fi
  echo
  for i in "${!V_NOMBRES[@]}"; do
    printf '  '
    rellenar "${V_NOMBRES[$i]}" 26
    printf '  '
    rellenar "${V_CIFRAS[$i]}" 46
    if [ "${V_ESTADOS[$i]}" = ok ]; then
      printf "  ${verde}✓${fin}\n"
    elif [ "${V_ESTADOS[$i]}" = omitido ]; then
      printf "  –\n"
      omitidos=$((omitidos + 1))
    else
      printf "  ${rojo}✗${fin}\n"
      fallos=$((fallos + 1))
    fi
  done
  echo
  for i in "${!V_NOMBRES[@]}"; do
    if [ "${V_ESTADOS[$i]}" = mal ] && [ -n "${V_REGISTROS[$i]}" ]; then
      malo "$(t ver-detalle "${V_NOMBRES[$i]}")"
      { grep -E 'XX |FALLA|FAILED|panicked|no está accesible' "${V_REGISTROS[$i]}" | head -n 10 || true; tail -n 8 "${V_REGISTROS[$i]}"; } | sed 's/^/    /' >&2
    fi
  done
  if [ "$fallos" = 0 ] && [ "$omitidos" = 0 ]; then
    azul "$(t ver-todo-bien)"
    return 0
  fi
  if [ "$fallos" = 0 ]; then
    gris "$(t ver-no-ci)"
    return 0
  fi
  malo "$(t ver-fallan "$fallos")"
  return 1
}

verificar() {
  local rc=0
  [ "${1:-}" != --sin-motores ] || V_SIN_MOTORES=1
  if [ -n "${JAVA_HOME:-}" ] && [ ! -x "$JAVA_HOME/bin/java" ]; then unset JAVA_HOME; fi
  V_TMP=$(mktemp -d)
  trap limpiar_verificar EXIT
  mkdir "$V_TMP/bin"
  if V_PY=$(buscar_python); then
    ln -s "$V_PY" "$V_TMP/bin/python3"
    export PATH="$V_TMP/bin:$PATH"
    gris "$(t ver-python "$V_PY" "$(python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])')")"
  else
    V_PY=""
    malo "$(t ver-sin-python)"
  fi
  paso_orden
  paso_pruebas
  paso_banco
  paso_h2spec
  paso_requisitos
  tabla_verificar || rc=1
  return $rc
}

case "${1:-ayuda}" in

  --version|-V|version)
    printf 'cero %s\nCero · por Andre Solorzano\n' "$(version)"
    ;;

  new|nuevo)
    requisitos
    [ -n "${2:-}" ] || { malo "$(t dime-nombre)"; exit 1; }
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    azul "$(t creando "$2")"
    java -cp "$JAVA_DIR/cero-launcher/target/classes" cero.launcher.Nuevo "${@:2}"
    ;;

  dist|paquete)
    requisitos
    azul "$(t dist-limpio)"
    (cd "$JAVA_DIR" && "${MVN[@]}" clean install -DskipTests) || {
      malo "$(t dist-no-compila)"; exit 1; }

    v=$(version)
    destino="$AQUI/dist"
    mkdir -p "$destino"

    rm -f "$destino"/cero-*.tar.gz "$destino"/cero-*.zip "$destino"/cero-*.sha256

    tmp=$(mktemp -d)
    mkdir -p "$tmp/cero-$v"
    COPYFILE_DISABLE=1 tar -cf - \
        --exclude target --exclude '*.class' --exclude .DS_Store --exclude classpath.txt \
        -C "$AQUI" java cero cero.cmd cero.ps1 LICENSE NOTICE README.md \
                  docs/instalar.sh docs/instalar.ps1 \
      | tar -xf - -C "$tmp/cero-$v"
    COPYFILE_DISABLE=1 tar -czf "$destino/cero-$v.tar.gz" -C "$tmp" "cero-$v"
    (cd "$tmp" && jar --create --file "$destino/cero-$v.zip" "cero-$v")
    rm -rf "$tmp"

    for f in "$destino/cero-$v.tar.gz" "$destino/cero-$v.zip"; do
      if command -v shasum >/dev/null; then shasum -a 256 "$f"; else sha256sum "$f"; fi \
        | sed "s| .*| $(basename "$f")|" > "$f.sha256"
      printf '  %-26s %6s KB\n' "$(basename "$f")" "$(( $(wc -c < "$f") / 1024 ))"
    done
    if [ "${2:-}" != "--sin-probar" ]; then
      azul "$(t dist-probando)"
      prueba=$(mktemp -d)
      tar -xzf "$destino/cero-$v.tar.gz" -C "$prueba"
      if (cd "$prueba/cero-$v" && mvn -B -q -f java/pom.xml test >"$prueba/salida.log" 2>&1); then
        gris "$(t dist-pasa)"
      else
        malo "$(t dist-no-pasa)"
        grep -E "XX |ERROR" "$prueba/salida.log" | head -12
        rm -rf "$prueba"
        exit 1
      fi
      rm -rf "$prueba"
    fi

    gris "$(t dist-huellas "$destino")"
    ;;

  run|correr)
    requisitos
    azul "$(t compilando-ej)"
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    azul "$(t arrancando "${2:-8080}")"
    java -cp "$(classpath_ejemplo)" ejemplo.App "${2:-8080}"
    ;;

  test|probar)
    requisitos
    if [ -n "${2:-}" ]; then
      azul "$(t probando "$2")"
      (cd "$JAVA_DIR" && mvn -B -o -q -pl "$2" -am test)
    else
      azul "$(t todas-pruebas)"
      (cd "$JAVA_DIR" && mvn -B -q test)
    fi
    ;;

  package|empaquetar)
    requisitos
    azul "$(t empaquetando)"
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests package)
    echo
    printf '  %-22s %10s\n' MÓDULO TAMAÑO
    local_total=0
    for m in $(modulos); do
      jar=$(ls "$JAVA_DIR/$m/target/$m"-*.jar 2>/dev/null | head -1) || continue
      [ -n "$jar" ] || continue
      bytes=$(wc -c < "$jar" | tr -d ' ')
      local_total=$((local_total + bytes))
      printf '  %-22s %7s KB\n' "$m" "$((bytes / 1024))"
    done
    printf '  %-22s %7s KB\n' "total" "$((local_total / 1024))"
    ;;

  install|instalar)
    requisitos
    azul "$(t instalando)"
    (cd "$JAVA_DIR" && mvn -B install)
    ;;

  clean|limpiar)
    azul "$(t borrando)"
    (cd "$JAVA_DIR" && "${MVN[@]}" clean) || true
    rm -rf "$JAVA_DIR"/*/target "$AQUI"/legacy/*/target 2>/dev/null || true
    find "$AQUI" -name '*.class' -not -path '*/.git/*' -delete 2>/dev/null || true
    gris "$(t listo)"
    ;;

  cache)
    if [ "${2:-}" = "--purge" ]; then
      azul "$(t cache-vaciando)"
      rm -rf "$HOME/.m2/repository/cero"
      gris "$(t cache-hecho)"
    else
      printf '  %-34s %10s\n' UBICACIÓN TAMAÑO
      for d in "$HOME/.m2/repository/cero" "$JAVA_DIR"/*/target "$AQUI/legacy"/*/target; do
        [ -d "$d" ] || continue
        printf '  %-34s %10s\n' "${d/#$AQUI/.}" "$(du -sh "$d" 2>/dev/null | cut -f1)"
      done
      echo
      gris "  ./cero cache --purge    vacía los artefactos de cero en ~/.m2"
      gris "  ./cero clean            borra los target/ del proyecto"
    fi
    ;;

  fatjar)
    requisitos
    modulo="${2:-ejemplo}"
    main="${3:-}"
    if [ -z "$main" ]; then
      case "$modulo" in
        ejemplo) main="ejemplo.App" ;;
        *) malo "$(t falta-clase)"; exit 1 ;;
      esac
    fi
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests install)
    (cd "$JAVA_DIR/$modulo" && "${MVN[@]}" dependency:build-classpath \
        -Dmdep.outputFile=target/classpath.txt >/dev/null)
    destino="$AQUI/$modulo.jar"
    java -cp "$JAVA_DIR/cero-launcher/target/classes" cero.launcher.Packager \
         --main "$main" --out "$destino" \
         "$JAVA_DIR/$modulo/target/classes" \
         $(tr ':' '\n' < "$JAVA_DIR/$modulo/target/classpath.txt")
    azul "arráncalo con:  java -jar $(basename "$destino")"
    ;;

  status|estado)
    printf '  %-16s %s\n' versión "$(grep -m1 '<version>' "$JAVA_DIR/pom.xml" | sed 's/.*<version>\(.*\)<.*/\1/')"
    printf '  %-16s %s\n' java "$(java -version 2>&1 | head -1 | cut -d'"' -f2)"
    printf '  %-16s %s clases, %s líneas\n' código \
      "$(find "$JAVA_DIR" -path '*/src/main/*' -name '*.java' | wc -l | tr -d ' ')" \
      "$(find "$JAVA_DIR" -path '*/src/main/*' -name '*.java' -exec cat {} + | wc -l | tr -d ' ')"
    printf '  %-16s %s líneas\n' pruebas \
      "$(find "$JAVA_DIR" -path '*/src/test/*' -name '*.java' -exec cat {} + | wc -l | tr -d ' ')"
    printf '  %-16s %s\n' dependencias \
      "$(grep -rl 'jakarta\|springframework' "$JAVA_DIR"/cero-http/src/main "$JAVA_DIR"/cero-core/src/main 2>/dev/null | wc -l | tr -d ' ') externas en el núcleo"
    printf '  %-16s %s\n' repositorio "$(git -C "$AQUI" rev-parse --short HEAD 2>/dev/null || echo '—')"
    ;;

  migraciones)
    requisitos
    [ "${2:-}" = "--verificar" ] || {
      malo "$(t uso-migraciones)"; exit 1; }
    dir="${3:-db/migraciones}"
    [ -d "$dir" ] || { malo "$(t no-migraciones "$dir")"; exit 1; }
    (cd "$JAVA_DIR" && "${MVN[@]}" -DskipTests -pl cero-launcher -am install)
    cp="$JAVA_DIR/cero-launcher/target/classes:$JAVA_DIR/cero-data/target/classes:$JAVA_DIR/cero-core/target/classes"
    driver="${CERO_JDBC_JAR:-$(ls "$HOME"/.m2/repository/com/h2database/h2/*/h2-*.jar 2>/dev/null | head -1)}"
    [ -n "$driver" ] || { malo "$(t falta-driver)"; exit 1; }
    java -cp "$cp:$driver" cero.launcher.Migraciones "$dir" ${4:+"$4"}
    ;;

  migrar|migrate)
    destino="${2:-}"
    [ -n "$destino" ] || { malo "$(t uso-migrar)"; exit 1; }
    [ -d "$destino" ] || { malo "$(t no-carpeta "$destino")"; exit 1; }
    ensayo=""
    [ "${3:-}" = "--probar" ] || [ "${3:-}" = "--dry-run" ] && ensayo="1"

    if [ -z "$ensayo" ] && git -C "$destino" rev-parse --git-dir >/dev/null 2>&1; then
      if [ -n "$(git -C "$destino" status --porcelain)" ]; then
        malo "$(t git-sucio "$destino")"
        malo "$(t git-commitea)"
        exit 1
      fi
    fi

    python3 "$AQUI/java/cero-launcher/src/main/resources/migrar.py" "$destino" ${ensayo:+--probar}
    ;;

  verificar|verify)
    verificar "${@:2}"
    ;;

  *)
    azul "$(t ayuda-titulo)"
    echo
    if [ "$IDIOMA" = es ]; then
      set -- "crea un proyecto nuevo y listo para arrancar" "arranca la aplicación de ejemplo" \
             "corre las pruebas" "genera los JAR y muestra sus tamaños" \
             "un solo jar ejecutable con java -jar" "compila, prueba e instala en ~/.m2" \
             "arma el .tar.gz y el .zip del instalador" "borra lo generado" \
             "qué ocupa la caché, o vaciarla" "resumen del proyecto" \
             "con --verificar, prueba las migraciones en una base desechable" \
             "migra una aplicación anterior a Cero 0.6.0" \
             "lo esencial de CI, en una orden: ✓ o ✗ por comprobación"
    else
      set -- "create a new project, ready to run" "start the example application" \
             "run the tests" "build the JARs and show their sizes" \
             "a single jar you can run with java -jar" "build, test and install into ~/.m2" \
             "build the .tar.gz and .zip the installer serves" "remove build output" \
             "what the cache holds, or empty it" "a summary of the project" \
             "with --verificar, tries the migrations against a throwaway database" \
             "migrate an application from an earlier Cero" \
             "the core of CI, in one command: ✓ or ✗ per check"
    fi
    if [ "$IDIOMA" = es ]; then
      NOMBRE=nombre; PUERTO=puerto; MODULO=modulo; RUTA=ruta
    else
      NOMBRE=name; PUERTO=port; MODULO=module; RUTA=path
    fi
    fila() {
      local n=${#1}
      printf '  %s' "$1"
      while [ "$n" -lt 24 ]; do printf ' '; n=$((n + 1)); done
      printf ' %s\n' "$2"
    }
    fila "./cero new <$NOMBRE>"       "$1"
    fila "./cero run [$PUERTO]"       "$2"
    fila "./cero test [$MODULO]"      "$3"
    fila "./cero package"             "$4"
    fila "./cero fatjar [$MODULO]"    "$5"
    fila "./cero install"             "$6"
    fila "./cero dist"                "$7"
    fila "./cero clean"               "$8"
    fila "./cero cache [--purge]"     "$9"
    fila "./cero status"              "${10}"
    fila "./cero migraciones"         "${11}"
    fila "./cero migrar <$RUTA>"      "${12}"
    fila "./cero verificar"           "${13}"
    ;;
esac
